{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-bash.sh",
            "timeout": 10,
            "statusMessage": "Comprobando comando…"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-supabase-sql.sh",
            "timeout": 5,
            "statusMessage": "Comprobando SQL…"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\":false,\"stopReason\":\"apply_migration bloqueado. Las migraciones requieren ✅ de Kristian.\"}' && exit 2",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-verificar.sh",
            "timeout": 120,
            "statusMessage": "Verificando antes de cerrar…"
          }
        ]
      }
    ]
  }
}
